# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Local MongoDB (development)
MONGODB_URI=mongodb://localhost:27017/portfolio

# MongoDB Atlas (production - uncomment for cloud database)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Gmail Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Note: For Gmail, you need to:
# 1. Enable "Less secure app access" or
# 2. Use an "App Password" if 2FA is enabled
# Check: https://myaccount.google.com/apppasswords

# Alternative: Use SendGrid, Mailgun, or other providers
# Just update the EMAIL_SERVICE and credentials accordingly

# ========================================
# ADMIN CONFIGURATION  
# ========================================
ADMIN_KEY=your-secure-admin-key-here

# ========================================
# PRODUCTION SETTINGS (Optional)
# ========================================
# CORS_ORIGIN=https://yourdomain.com
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX_REQUESTS=10
